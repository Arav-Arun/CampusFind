{
  "name": "campusfind-server",
  "version": "1.0.0",
  "description": "CampusFind API: Express, Postgres (Neon), OpenAI, Cloudinary",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:sync": "node -e \"require('dotenv').config();require('./db').sequelize.sync().then(()=>{console.log('Tables are up to date');process.exit(0)})\"",
    "test": "node --test test/api.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.0.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.77.3",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=20"
  }
}
