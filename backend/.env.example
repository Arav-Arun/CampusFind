# Postgres connection string (Neon, or a local Postgres)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Signs login tokens. Required in production; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=

# OpenAI: photo tagging (the app still works without it, with generic tags)
OPENAI_API_KEY=

# Cloudinary: photo hosting (required to report items)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin: verifies Google sign-in tokens.
# Production/Vercel: the whole service-account JSON on one line
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local: path to the service-account file instead (kept out of git)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
